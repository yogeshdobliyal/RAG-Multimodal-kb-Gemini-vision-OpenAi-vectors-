      "parameters": {
        "jsCode": "const meta = $json._meta || {};\nconst text = meta.directText || '';\nif (!text.trim()) throw new Error('No text content found in the uploaded file.');\n\nconst buf = Buffer.from(text, 'utf8');\nreturn [{\n  json: {\n    source:             'direct_extract',\n    model:              'none',\n    originalFileName:   meta.originalFileName || 'file',\n    originalMimeType:   meta.originalMimeType || 'text/plain',\n    ingestedAt:         new Date().toISOString()\n  },\n  binary: {\n    data: {\n      data:             buf.toString('base64'),\n            mimeType: 'text/plain',\n      fileName: 'extracted.txt'\n    }\n  }\n}];\n\n"
