      "parameters": {
        "jsCode": "const root = $input.first().json;\nconst text = root.candidates?.[0]?.content?.parts?.map(p =>\np.text).join('\\n') || '';\nif (!text.trim()) throw new Error('Gemini returned no text. Check API key and model availability.');\n\n// Back-reference metadata captured before the HTTP call\nconst meta = $('Build Gemini Request').first().json?._meta || {};\n\nconst buf = Buffer.from(text, 'utf8');\nreturn [{\n  json: {\n    source:           'gemini_vision',\n    model:            'gemini-2.0-flash',\n    originalFileName: meta.originalFileName || 'image',\n    originalMimeType: meta.originalMimeType || 'image/jpeg',\n        ingestedAt:         new Date().toISOString()\n  },\n  binary: {\n    data: {\n      data:             buf.toString('base64'),\n      mimeType:         'text/plain',\n      fileName:         'gemini_extracted.txt'\n    }\n  }\n}];\n\n"
