    {
      "parameters": {
        "jsCode": "const b = $input.first().binary;\nif (!b) throw new Error('Upload a file as multipart binary (field \"data\").');\nconst k = Object.keys(b)[0];\nconst bin = b[k];\nconst mime = (bin.mimeType || 'application/octet-stream').toLowerCase().split(';')[0].trim();\n\n// -- MIME routing tables\nconst DIRECT_TYPES = new Set([\n  'text/plain', 'text/markdown', 'text/x-markdown', 'text/csv',\n  'text/html', 'text/xml', 'application/json', 'application/xml'\n]);\n\nconst GEMINI_TYPES = new Set([\n  // Images\n  'image/jpeg', 'image/png', 'image/gif', 'image/webp', 'image/heic', 'image/heif',\n  // Documents\n  'application/pdf',\n  // Audio\n  'audio/wav', 'audio/mp3', 'audio/mpeg', 'audio/aiff', 'audio/aac', 'audio/ogg', 'audio/flac',\n  // Video\n  'video/mp4', 'video/mpeg', 'video/quicktime', 'video/x-msvideo', 'video/x-flv',\n  'video/webm', 'video/x-ms-wmv', 'video/3gpp'\n]);\n\nconst UNSUPPORTED = {\n  'application/vnd.openxmlformats-officedocument.wordprocessingml.document':\n    'DOCX detected - convert to PDF (File > Export > PDF) and re-upload.',\n  'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet':\n    'XLSX detected - export as CSV (File > Save As > CSV) and re-upload.',\n  'application/msword':\n    'DOC detected - convert to PDF and re-upload.',\n  'application/vnd.ms-excel':\n    'XLS detected - export as CSV and re-upload.'\n};\n\nif (UNSUPPORTED[mime]) throw new Error(UNSUPPORTED[mime]);\n\nconst fileBuffer = await this.helpers.getBinaryDataBuffer(0, k);\nconst b64 = fileBuffer.toString('base64');\nconst meta = {\n  originalFileName: bin.fileName || 'uploaded_file',\n  originalMimeType: mime\n};\n\n// -- Route: direct text (no Gemini needed)\nif (DIRECT_TYPES.has(mime)) {\n  const text = Buffer.from(b64, 'base64').toString('utf8');\n  return [{ json: { _meta: { ...meta, route: 'direct' }, directText: text } }];\n}\n\n// -- Route: Gemini (images, PDF, audio, video)\nif (!GEMINI_TYPES.has(mime)) {\n  throw new Error(\n    `Unsupported file type: \"${mime}\". ` +\n    'Supported: images (jpg/png/gif/webp), PDF, audio (wav/mp3/aac), ' +\n    'video (mp4/mov/webm), text/markdown/csv/json.'\n  );\n}\n\nconst requestBody = {\n  contents: [{\n    parts: [\n      { text: 'Extract all text from this file and describe everything in it in detail.' },\n      { inline_data: { mime_type: mime, data: b64 } }\n    ]\n  }]\n};\n\nreturn [{ json: { _meta: { ...meta, route: 'gemini' }, requestBody } }];"
      },
