      "parameters": {
        "jsCode": "const answer = $input.first().json.response ||'';\nconst question = $('Code -- Parse & Validate Question').first().json.question;\n\n// Detect \"not found\" signals\nconst notFoundPhrases = [\n  \"i don't know\", \"i do not know\", \"i cannot find\",\n  \"not found in\", \"no information\", \"not mentioned\",\n  \"i have no\", \"unable to find\", \"doesn't contain\"\n];\nconst notFound = !answer || \n  notFoundPhrases.some(p => answer.toLowerCase().includes(p)) || \nanswer.startsWith('❌');\nconst partial     = answer.startsWith('⚠️');\n\n// Citation & Quality Checks\nconst hasCite     = answer.includes('📄 Source:') || \nanswer.includes('\\ud83d\\udcc4 Source:') || /source:/i.test(answer);\nconst wordCount   = answer.split(/\\s+/).filter(Boolean).length;\n\nconst debugFlags = [];\n\nif (!hasCite && !notFound)\ndebugFlags.push('missing_citation');\nif (wordCount < 10 && !notFound)\ndebugFlags.push('very_short');\nif (answer.includes(notFoundPhrases[0]) && !notFound)\ndebugFlags.push('hallucinated_fallback');\n\nconst httpStatus = notFound ? 404 : 200; // ternary operator\n\nreturn [{\n  json: {\n    question,\n    answer: notFound ? '\\u274c No relevant information found in the knowledge base for your query.' : answer,\n    status: notFound ? 'not_found' : (partial ? 'partial' : 'ok'),\n    has_citation: hasCite,\n    http_status: httpStatus,\n    debug: debugFlags.length > 0 ? debugFlags : undefined,\n    answered_at: new Date().toISOString()\n  }\n}];\n"
      },
